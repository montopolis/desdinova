---
import desdinovaConfig from '../../config/desdinova-config';
interface Props {
	date: Date;
}

const { date } = Astro.props;

// Adjust the date to account for timezone differences
const correctedDate = new Date(date.getTime() + date.getTimezoneOffset() * 60000);
---

<time>
	{
		new Intl.DateTimeFormat(desdinovaConfig.localeDateString, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}).format(correctedDate)
	}
</time>
