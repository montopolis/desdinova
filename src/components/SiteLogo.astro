---
import { Image } from 'astro:assets';
import desdinovaConfig from '../config/desdinova-config';
import LogoSquare from '/src/assets/images/logo-square.png';
import Logo from '/src/assets/images/logo.png';

interface Props {
	style?: 'square' | 'full';
	loading?: 'eager' | 'lazy' | null;
	classText?: string;
	alt?: string;
}

const url = new URL(Astro.url);
const {
	style = 'full',
	classText = 'text-xl font-semibold dark:text-white',
	loading = 'lazy',
	alt = desdinovaConfig.name,
} = Astro.props;

const defaultClassSquareLogo = 'whitespace-nowrap text-left align-middle';
const defaultClassFullLogo = 'mt-1 mr-3 align-middle';
const combinedClassesSquareLogo = `${defaultClassSquareLogo} ${classText}`;
const combinedClassesFullLogo = `${defaultClassFullLogo} ${classText}`;
---

<div id="logo" class="inline items-center text-left">
	<a href={url.origin}>
		<!--Square Logo with Text Site Title-->
		{style === 'square' ? (
			<Image
				src={LogoSquare}
				width={64}
				height={64}
				loading={loading}
				class="mr-3 mt-1 inline"
				alt={alt}
			/>
			<span class={combinedClassesSquareLogo}>{desdinovaConfig.name}</span>
		) : (
			<Image src={Logo} alt={alt} width={175} loading={loading} class={combinedClassesFullLogo} />
		)}
	</a>
</div>
