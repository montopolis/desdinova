{
	"name": "desdinova",
	"version": "0.5.1",
	"type": "module",
	"scripts": {
		"astro": "astro",
		"build": "astro check && astro build",
		"changelog": "npx auto-changelog --hide-credit -t keepachangelog --sort-commits date-desc",
		"check": "astro check",
		"dev": "astro dev",
		"prettier": "npx prettier --write --list-different .",
		"preview": "astro preview",
		"release": "npm run astro check && npm run prettier && npx release-it",
		"start": "astro dev",
		"upgrade": "npx @astrojs/upgrade"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/mdx": "^4.3.12",
		"@astrojs/sitemap": "^3.6.0",
		"@astrolib/seo": "^1.0.0-beta.8",
		"@fontsource-variable/aleo": "^5.2.7",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/montserrat": "^5.2.8",
		"@playform/compress": "^0.2.0",
		"@tailwindcss/vite": "^4.1.17",
		"astro": "^5.16.4",
		"astro-embed": "^0.9.2",
		"astro-icon": "^1.1.5",
		"astro-pagefind": "^1.8.5",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@iconify-json/flowbite": "^1.2.7",
		"@iconify-json/line-md": "^1.2.11",
		"@iconify-json/logos": "^1.2.10",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/tabler": "^1.2.23",
		"@tailwindcss/typography": "^0.5.19",
		"flowbite": "^4.0.1",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.7.2"
	},
	"auto-changelog": {
		"output": "CHANGELOG.md",
		"template": "keepachangelog",
		"sort-commits": "date-desc",
		"unreleased": true,
		"commitLimit": false
	}
}
